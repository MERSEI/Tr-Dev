# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OpenAI (или любой OpenAI-совместимый провайдер) ──────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Если используешь другой провайдер (Azure, vLLM, LiteLLM и т.д.):
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# ── Mock-режим LLM (без реального API-ключа) ──────────────────────────────────
# Установи LLM_MOCK=true чтобы пайплайн работал без OpenAI
LLM_MOCK=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://bot:bot@postgres:5432/botdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Collector ─────────────────────────────────────────────────────────────────
# "mock" для локального теста без реального Instagram
# "instagram" для реального сбора (публичные профили)
COLLECTOR_PROVIDER=mock

# Опционально: путь к файлу сессии instaloader (для снижения rate-limit)
# INSTAGRAM_SESSION_FILE=/data/instagram_session

# ── STT (faster-whisper) ──────────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── OCR (easyocr) ─────────────────────────────────────────────────────────────
# Список языков через запятую
OCR_LANGUAGES=["ru","en"]

# ── Media Storage ─────────────────────────────────────────────────────────────
MEDIA_ROOT=/data/media
MEDIA_TTL_DAYS=7

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── Analysis ──────────────────────────────────────────────────────────────────
ANALYSIS_WINDOW_HOURS=24

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
